{
  "manifest_version": 3,
  "name": "LatentFill - AI Job Application Autofill",
  "version": "1.3.0",
  "description": "Fill job applications from your resume using your own AI API key. No daily limits.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LatentFill"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "run-autofill": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Autofill the job application on this page"
    }
  }
}